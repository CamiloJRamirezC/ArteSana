# Configuración local de ArteSana. artesana.bat crea "artesana.env" a partir de este archivo.
# Después de cambiar algo, usá "Reiniciar" en el menú.

# Puerto: la app se abre en http://127.0.0.1:PUERTO
PUERTO=5000

# 127.0.0.1 = solo esta computadora.
# 0.0.0.0   = también desde el celular u otras PCs en tu Wi-Fi (poné una contraseña abajo).
HOST=127.0.0.1

# Contraseña para entrar (vacía = no pide contraseña). Recomendada si HOST=0.0.0.0
APP_PASSWORD=

# Buscar actualizaciones en GitHub y aplicarlas solas (1 = sí, 0 = solo avisar)
AUTO_ACTUALIZAR=1
INTERVALO_MINUTOS=30
RAMA=main

# Vacío = los datos se guardan en instance\artesana.db (en esta computadora).
# Para compartir los datos con la versión publicada en Render, pegá acá la de Supabase.
DATABASE_URL=
