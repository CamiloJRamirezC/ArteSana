# Copiá estas variables en Render (Environment). En tu computadora no hace falta ninguna:
# sin DATABASE_URL usa un archivo SQLite local y sin APP_PASSWORD no pide contraseña.

# Clave para firmar la sesión. Render la genera sola con render.yaml.
SECRET_KEY=cambiar-por-un-texto-largo-al-azar

# Contraseña para entrar a la app.
APP_PASSWORD=elegi-una-contraseña

# Supabase > Connect > Session pooler (reemplazá [YOUR-PASSWORD] por la clave de la base)
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
